# ============================================
# SERVER CONFIGURATION
# ============================================

# Port for the backend server
PORT=5001

# Node environment (development | production)
NODE_ENV=development

# Maximum file size for CSV uploads (in bytes)
# 10485760 = 10MB
MAX_FILE_SIZE=10485760

# ============================================
# AI PROVIDER CONFIGURATION
# ============================================

# Option 1: OpenRouter (Recommended - Free Tier)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Option 2: Groq (Alternative - Free Tier)
# Get your API key from: https://console.groq.com/keys
# GROQ_API_KEY=your_groq_api_key_here

# Option 3: Google Gemini (Alternative - Free Tier)
# Get your API key from: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# BATCH PROCESSING CONFIGURATION
# ============================================

# Number of records to process in each AI request
# Smaller = safer for rate limits, larger = faster
# Recommended: 3-5 for free tier, 10-20 for paid
BATCH_SIZE=5

# ============================================
# MULTIPLE API KEYS (For Groq Only)
# ============================================

# Comma-separated list of Groq API keys for load balancing
# GROQ_API_KEYS=key1,key2,key3

# ============================================
# VERTEX AI (For Gemini Enterprise)
# ============================================

# Google Cloud Project ID (required if using Vertex AI)
# GOOGLE_CLOUD_PROJECT_ID=your-project-id-here

# ============================================
# OPTIONAL: Rate Limit Configuration
# ============================================

# Maximum requests per user per hour
# RATE_LIMIT_PER_USER=10

# Rate limit window in milliseconds (1 hour = 3600000)
# RATE_LIMIT_WINDOW=3600000

# ============================================
# OPTIONAL: CORS Configuration
# ============================================

# Allowed origins for CORS (comma-separated)
# CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# ============================================
# OPTIONAL: Logging
# ============================================

# Log level (debug | info | warn | error)
# LOG_LEVEL=info